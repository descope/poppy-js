{
  "name": "@descope/poppy",
  "version": "0.0.0",
  "description": "TypeScript Personal Agent SDK for the Personal Agent Protocol (Poppy) draft 0.3: discovery, delegated Session JWTs, Direct, Device and Mediated Sign-In, APIs, browser join, conversations, task coverage and operations.",
  "keywords": [
    "agent",
    "agents",
    "dpop",
    "mcp",
    "oauth",
    "personal-agent",
    "personal-agent-protocol",
    "poppy",
    "sdk"
  ],
  "homepage": "https://github.com/descope/poppy-js#readme",
  "bugs": {
    "url": "https://github.com/descope/poppy-js/issues"
  },
  "license": "Apache-2.0",
  "author": "Descope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descope/poppy-js.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm --filter @descope/poppy-conformance run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "conformance": "node packages/conformance/src/cli.ts agent --command \"node examples/conformance-agent.ts\""
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "ai": "7.0.150",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.8"
}
